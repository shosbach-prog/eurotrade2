# www → ohne www (eine Adresse für Google)
www.euro-trade.com {
  redir https://euro-trade.com{uri} permanent
}

euro-trade.com {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
  # statische Dateien lange cachen
  @static path /_next/static/*
  header @static Cache-Control "public, max-age=31536000, immutable"
  @media path /p/* /og.png /icon.svg
  header @media Cache-Control "public, max-age=604800"
  reverse_proxy shop:3000
}
