# ---- Shop ----
SHOP_NAME=Euro-Trade
SHOP_URL=https://euro-trade.com
# Aufschlag auf den L-Shop-Einkaufspreis in Prozent
MARKUP_PERCENT=35
# Optional: Aufschlag pro Kategorie (JSON, Kategorie-Slug -> Prozent)
# MARKUP_BY_CATEGORY={"t-shirts":40,"taschen":25}
# Staffelrabatt auf den Verkaufspreis: Menge:Prozent (leer = keine Staffel)
PRICE_TIERS=10:5,50:10,100:15
# Preise auf ,x9 runden (true/false)
PRICE_ROUND_99=true
MWST_PERCENT=19

# ---- Admin (/admin: Anfragen, Angebote, Kunden & Codes) ----
ADMIN_PASSWORD=
# Absender im Angebots-PDF (Zeilen mit | trennen)
# OFFER_SENDER=Euro-Trade · Sebastian Hosbach|Seehan 28 · 44263 Dortmund|Tel. 0173 2648097 · info@euro-trade.com

# ---- Zugang (geschlossener Shop) ----
# true = Shop nur mit Code. Codes legen Sie bequem im Admin unter „Kunden & Codes“ an.
SHOP_CLOSED=true
# Optional zusätzlich Codes direkt hier (Komma-getrennt, Name nach Doppelpunkt):
# ACCESS_CODES=FIRMA24:Firma Muster GmbH,VEREIN-XY:SV Musterstadt
ACCESS_CODES=
# Langer Zufallswert (z. B. openssl rand -hex 32). Ändern = alle Freischaltungen ungültig
ACCESS_SECRET=

# ---- L-Shop API (Key folgt) ----
LSHOP_API_URL=
LSHOP_API_KEY=
# Wie der Key gesendet wird: header (Authorization: Bearer) | x-api-key | query (?apikey=)
LSHOP_AUTH_MODE=header

# ---- Anfragen per E-Mail ----
INQUIRY_TO=info@euro-trade.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Euro-Trade Shop <shop@euro-trade.com>"
