+.nl-pct{display:inline-grid;place-items:center;min-width:56px;height:32px;border-radius:999px;background:#fff;border:1px solid #f0d77a;font-weight:800;color:#14181f}
+.nl-tiers li.top .nl-pct{background:var(--accent);border-color:var(--accent)}
+.nl-hot{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.6px;background:#ff5a1f;color:#fff;border-radius:999px;padding:2px 8px}
+.nl-form{display:flex;flex-direction:column;gap:10px}
+.nl-row{display:flex;gap:0;box-shadow:0 2px 8px rgba(0,0,0,.06);border-radius:10px;overflow:hidden}
+.nl-row input{flex:1;min-width:0;border:1px solid var(--line);border-right:0;border-radius:10px 0 0 10px;padding:0 16px;height:52px;font-size:16px}
+.nl-btn{height:52px;border-radius:0 10px 10px 0;background:var(--accent);color:#14181f;font-weight:800;text-transform:uppercase;letter-spacing:.3px;white-space:nowrap}
+.nl-form select{height:48px;border:1px solid var(--line);border-radius:10px;padding:0 14px;background:#fff;font-size:15px;color:#3b4250}
+.nl-priv{display:flex;gap:8px;align-items:flex-start;font-size:13px;color:#3b4250;cursor:pointer}
+.nl-priv input{margin-top:3px}
+.nl-priv a{color:var(--brand);text-decoration:underline}
+.nl-hint{font-size:13px;margin:0;color:#3b4250}
+.nl-small{font-size:12px;font-style:italic;color:var(--muted);margin:0}
+.nl-done{background:#fff;border:1px solid #cdebd8;border-radius:14px;padding:20px}
+.nl-done strong{color:var(--ok);font-size:17px}
+.nl-done p{margin:8px 0 0}
+@media (max-width:820px){.nl{grid-template-columns:1fr;padding:24px 18px}.nl h2{font-size:24px}.nl-row{flex-direction:column;box-shadow:none}.nl-row input{border-right:1px solid var(--line);border-radius:10px}.nl-btn{border-radius:10px;margin-top:8px}}
+.code-row{display:flex;gap:8px;margin-top:14px}
+.code-row input{flex:1;min-width:0;border:1px dashed #d6b34a;background:#fffdf3;border-radius:8px;padding:0 12px;height:42px;font:600 15px ui-monospace,Menlo,monospace;letter-spacing:1px}
+.code-row .btn{height:42px}
+/* Rückgabe-Seite */
+.ret-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:20px 0 10px}
+.ret{display:flex;flex-direction:column;gap:6px}
+.ret-ico{width:44px;height:44px;border-radius:12px;background:var(--accent);color:#14181f;font-weight:900;font-size:18px;display:grid;place-items:center}
+.ret h3{margin:4px 0 0;font-size:16px}
+.ret p{margin:0;font-size:14px;color:var(--muted)}
+.legal-page .legal h3{font-size:16px;margin:18px 0 6px}
+.form-line{letter-spacing:1px;color:var(--muted)}
+@media (max-width:900px){.ret-grid{grid-template-columns:1fr 1fr}}
+@media (max-width:520px){.ret-grid{grid-template-columns:1fr}}
